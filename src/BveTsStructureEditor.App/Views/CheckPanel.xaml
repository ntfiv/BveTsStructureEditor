<UserControl x:Class="BveTsStructureEditor.App.Views.CheckPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8,6">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"
                   Text="項目を選んで「選択」で該当箇所を選択、「直す」で自動修正（元に戻せます）。編集すると調べ直します。" />
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Content="再チェック" Click="OnRecheck" FontWeight="SemiBold" />
            <Button x:Name="SelectButton" Content="選択" Click="OnSelect" IsEnabled="False" />
            <Button x:Name="FixButton" Content="直す" Click="OnFix" IsEnabled="False" />
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Margin="8,0,0,0" />
        </WrapPanel>
        <ListBox x:Name="List" SelectionChanged="OnSelectionChanged" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2">
                        <Border DockPanel.Dock="Left" Width="40" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Top" Background="{Binding Badge}">
                            <TextBlock Text="{Binding Issue.SeverityLabel}" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FixLabel}" Foreground="#3A7" FontSize="11" VerticalAlignment="Top" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding Issue.Message}" TextWrapping="Wrap" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
