<UserControl x:Class="BveTsStructureEditor.App.Views.CreatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ShapeGroup" TargetType="GroupBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <EventSetter Event="MouseEnter" Handler="OnGroupActivated" />
            <EventSetter Event="PreviewGotKeyboardFocus" Handler="OnGroupActivated" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,6">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,2"
                       Text="底面 Y=0・原点中心で追加し、追加したメッシュを選択します。" />
            <CheckBox x:Name="PreviewCheck" IsChecked="True" Click="OnPreviewToggled" Margin="0,2,0,8"
                      Content="3D ビューにプレビュー（水色の枠）" ToolTip="マウスを乗せた・入力中の形を 3D ビューに水色の枠で表示します" />

            <GroupBox x:Name="BoxGroup" Header="箱" Style="{StaticResource ShapeGroup}" Tag="Box">
                <WrapPanel>
                    <TextBlock Text="幅 (X)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BoxW" Text="4" Width="48" TextChanged="OnParamChanged" />
                    <TextBlock Text="高さ (Y)" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                    <TextBox x:Name="BoxH" Text="3" Width="48" TextChanged="OnParamChanged" />
                    <TextBlock Text="奥行 (Z)" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                    <TextBox x:Name="BoxD" Text="4" Width="48" TextChanged="OnParamChanged" />
                    <TextBlock Text="m" Style="{StaticResource FieldLabel}" />
                    <Button Content="箱を追加" Click="OnAddBox" FontWeight="SemiBold" />
                </WrapPanel>
            </GroupBox>

            <GroupBox x:Name="PlaneGroup" Header="板" Style="{StaticResource ShapeGroup}" Tag="Plane">
                <WrapPanel>
                    <TextBlock Text="幅" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PlaneW" Text="4" Width="48" TextChanged="OnParamChanged" />
                    <TextBlock Text="高さ" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                    <TextBox x:Name="PlaneH" Text="2" Width="48" TextChanged="OnParamChanged" />
                    <TextBlock Text="m" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PlaneKind" SelectedIndex="0" Width="130" SelectionChanged="OnParamChanged">
                        <ComboBoxItem Content="立てる (-Z 向き)" />
                        <ComboBoxItem Content="寝かせる (上向き)" />
                    </ComboBox>
                    <Button Content="板を追加" Click="OnAddPlane" FontWeight="SemiBold" />
                </WrapPanel>
            </GroupBox>

            <GroupBox x:Name="CylGroup" Header="円柱" Style="{StaticResource ShapeGroup}" Tag="Cylinder">
                <StackPanel>
                    <WrapPanel>
                        <ComboBox x:Name="CylShape" Width="56" SelectedIndex="0" SelectionChanged="OnParamChanged"
                                  ToolTip="直線: まっすぐな円柱 / L字: 縦に立ち上がって横へ曲がる形">
                            <ComboBoxItem Content="直線" />
                            <ComboBoxItem Content="L字" />
                        </ComboBox>
                        <TextBlock Text="半径" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                        <TextBox x:Name="CylR" Text="0.15" Width="48" TextChanged="OnParamChanged" />
                        <TextBlock Text="高さ" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                        <TextBox x:Name="CylH" Text="8" Width="48" TextChanged="OnParamChanged"
                                 ToolTip="直線: 円柱の高さ / L字: 地面から横の管の中心線までの高さ" />
                        <TextBlock Text="m" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="分割数" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                        <TextBox x:Name="CylSeg" Text="12" Width="40" TextChanged="OnParamChanged" />
                    </WrapPanel>
                    <WrapPanel x:Name="ElbowRow" Visibility="Collapsed">
                        <TextBlock Text="横の長さ" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ElbowLength" Text="3" Width="48" TextChanged="OnParamChanged"
                                 ToolTip="縦の管の中心線から、横の管の先端までの長さ" />
                        <TextBlock Text="曲げ半径" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                        <TextBox x:Name="ElbowBend" Text="0.5" Width="48" TextChanged="OnParamChanged"
                                 ToolTip="曲がりの中心線の半径。0 なら角ばった継ぎ目。管の半径以上、縦・横の長さ以下" />
                        <TextBlock Text="m" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="向き" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                        <ComboBox x:Name="ElbowDir" Width="64" SelectedIndex="0" SelectionChanged="OnParamChanged"
                                  ToolTip="横の管が伸びる向き（+Z が進行方向、+X が右）">
                            <ComboBoxItem Content="+Z" />
                            <ComboBoxItem Content="-Z" />
                            <ComboBoxItem Content="+X" />
                            <ComboBoxItem Content="-X" />
                        </ComboBox>
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox x:Name="PipeCheck" Content="パイプ（中空）" Checked="OnParamChanged" Unchecked="OnParamChanged" VerticalAlignment="Center" Margin="0,2,6,2"
                                  ToolTip="中に穴のあいた筒にします。管・煙突・ヒューム管など" />
                        <TextBlock Text="厚さ" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PipeThickness" Text="0.02" Width="48" TextChanged="OnParamChanged"
                                 IsEnabled="{Binding IsChecked, ElementName=PipeCheck}" ToolTip="管の肉厚。半径より小さくしてください" />
                        <TextBlock Text="m" Style="{StaticResource FieldLabel}" />
                        <Button x:Name="CylAddButton" Content="円柱を追加" Click="OnAddCylinder" FontWeight="SemiBold" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <Expander x:Name="ProfileSection" Header="描いて作る（断面・建物・回転体）" IsExpanded="False" Margin="0,4,0,4">
                <StackPanel Margin="4,4,0,4">
                    <WrapPanel>
                        <TextBlock Text="描く面" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ExtrudePlane" Width="190" SelectedIndex="0" SelectionChanged="OnExtrudePlaneChanged"
                                  ToolTip="正面図: 車体・ホーム・擁壁などの断面を描き、進行方向 (+Z) に押し出します。&#x0a;上面図: 地理院地図などの下絵で建物の輪郭をなぞり、上 (+Y) に押し出します">
                            <ComboBoxItem Content="正面図（断面 → 奥へ）" />
                            <ComboBoxItem Content="上面図（建物の輪郭 → 上へ）" />
                        </ComboBox>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock x:Name="ExtrudeLengthLabel" Text="奥行 (Z)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ProfileDepth" Text="20" Width="48" />
                        <TextBlock Text="m" Style="{StaticResource FieldLabel}" />
                        <Button Content="描いて押し出す" Click="OnDrawExtrude" FontWeight="SemiBold"
                                ToolTip="押すと選んだ面の向き・平行投影になります。角を順にクリックし、Enter かダブルクリックで確定。&#x0a;Ctrl: グリッド / Shift: 頂点に吸着 / Backspace: 1 点戻す / Esc: 取り消し" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="分割数" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LatheSegments" Text="16" Width="40" />
                        <TextBlock Text="角度" Style="{StaticResource FieldLabel}" Margin="6,0,4,0" />
                        <TextBox x:Name="LatheAngle" Text="360" Width="40" />
                        <TextBlock Text="°" Style="{StaticResource FieldLabel}" />
                        <Button Content="輪郭を描いて回転体に" Click="OnDrawLathe" FontWeight="SemiBold"
                                ToolTip="タンク・柱・碍子などの輪郭の右半分を正面図で描き、縦軸 (Y) まわりに回します。&#x0a;操作は断面の押し出しと同じです" />
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="ImageSection" Header="画像から板" IsExpanded="False" Margin="0,0,0,6"
                      ToolTip="3D ビューに画像ファイルをドロップしても、この設定で板を追加します">
                <StackPanel Margin="4,4,0,4">
                    <WrapPanel>
                        <ComboBox x:Name="ImageSizeMode" SelectedIndex="0" Width="130">
                            <ComboBoxItem Content="高さを指定" />
                            <ComboBoxItem Content="幅を指定" />
                            <ComboBoxItem Content="1px あたりの長さ" />
                        </ComboBox>
                        <TextBox x:Name="ImageSize" Text="3" Width="56" />
                        <TextBlock Text="m" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ImageKind" SelectedIndex="0" Width="130">
                            <ComboBoxItem Content="立てる (-Z 向き)" />
                            <ComboBoxItem Content="寝かせる (上向き)" />
                        </ComboBox>
                    </WrapPanel>
                    <CheckBox x:Name="EditBeforeImport" Content="取り込む前に編集する（歪み補正・シームレス化など）" Margin="0,2,0,2"
                              ToolTip="画像ごとに編集画面を開きます。編集した画像は .x と同じフォルダーに「元の名前_edit.png」で保存して使います（ドロップにも効きます）" />
                    <WrapPanel>
                        <Button Content="画像を選んで追加…" Click="OnAddImageFromDialog"
                                ToolTip="縦横比は画像に合わせ、地面 (Y=0) に置きます（ドロップしたときはその位置、複数なら横に並べる）。&#x0a;テクスチャは .x からの相対パス（未保存なら保存時に直します）。PNG/BMP/JPG/GIF/DDS" />
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <TextBlock x:Name="PreviewInfo" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
