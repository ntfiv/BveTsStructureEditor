<Window x:Class="BveTsStructureEditor.App.Views.SignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字から看板を作る" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <StackPanel Margin="16,14">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"
                   Text="駅名標・案内板などの文字を画像 (PNG) にして、テクスチャ付きの板として追加します。画像は .x と同じフォルダーに保存します。" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="文字（改行で複数行）" FontWeight="SemiBold" />
                <TextBox x:Name="SignText" Height="70" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         Text="東京&#x0a;Tokyo" TextChanged="OnChanged" Margin="0,2,0,6" />
                <WrapPanel>
                    <TextBlock Text="フォント" Style="{StaticResource FieldLabel}" Width="56" />
                    <ComboBox x:Name="FontBox" Width="150" SelectionChanged="OnChanged" />
                    <CheckBox x:Name="BoldCheck" Content="太字" IsChecked="True" Click="OnChanged" VerticalAlignment="Center" Margin="6,0,0,0" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="文字色" Style="{StaticResource FieldLabel}" Width="56" />
                    <TextBox x:Name="ForeColor" Text="#1A1A1A" Width="70" TextChanged="OnChanged" />
                    <TextBlock Text="背景" Style="{StaticResource FieldLabel}" Margin="8,0,4,0" />
                    <TextBox x:Name="BackColor" Text="#FFFFFF" Width="70" TextChanged="OnChanged" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="" Width="56" />
                    <CheckBox x:Name="TransparentCheck" Content="背景を透明にする" Click="OnChanged" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="余白" Style="{StaticResource FieldLabel}" Width="56" />
                    <TextBox x:Name="PaddingBox" Text="25" Width="40" TextChanged="OnChanged" />
                    <TextBlock Text="%（文字の高さに対して）" Style="{StaticResource FieldLabel}" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="配置" Style="{StaticResource FieldLabel}" Width="56" />
                    <ComboBox x:Name="AlignBox" Width="80" SelectedIndex="1" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="左" />
                        <ComboBoxItem Content="中央" />
                        <ComboBoxItem Content="右" />
                    </ComboBox>
                    <CheckBox x:Name="VerticalCheck" Content="縦書き" Click="OnChanged" VerticalAlignment="Center" Margin="8,0,0,0" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <ComboBox x:Name="SizeMode" Width="90" SelectedIndex="0" SelectionChanged="OnChanged">
                        <ComboBoxItem Content="高さを指定" />
                        <ComboBoxItem Content="幅を指定" />
                    </ComboBox>
                    <TextBox x:Name="SizeBox" Text="0.6" Width="50" TextChanged="OnChanged" />
                    <TextBlock Text="m" Style="{StaticResource FieldLabel}" />
                </WrapPanel>
                <WrapPanel>
                    <ComboBox x:Name="PlaneKind" Width="120" SelectedIndex="0">
                        <ComboBoxItem Content="立てる (-Z 向き)" />
                        <ComboBoxItem Content="寝かせる (上向き)" />
                    </ComboBox>
                    <CheckBox x:Name="DoubleSided" Content="裏からも読める両面" IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0" />
                </WrapPanel>
            </StackPanel>
            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="プレビュー" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Bottom" x:Name="Info" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,2,0,0" MinHeight="220">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#DDD" Geometry="M0,0 H2 V2 H0Z" />
                                    <GeometryDrawing Brush="#BBB" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                    <Image x:Name="Preview" Stretch="Uniform" Margin="8" />
                </Border>
            </DockPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="#C03030" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="作成して追加" IsDefault="True" MinWidth="120" FontWeight="SemiBold" Click="OnOk" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
