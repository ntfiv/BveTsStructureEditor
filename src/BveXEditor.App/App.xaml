<Application x:Class="BveXEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="LineBrush" Color="#D4D7DC" />
        <SolidColorBrush x:Key="SubTextBrush" Color="#5F6670" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E8871E" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2,4" />
        </Style>
        <!-- ラベル付き数値欄の見出し -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="8,4,6,8" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Application.Resources>
</Application>
