<Window x:Class="BveXEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BveXEditor.App.Views"
        Title="BVE X Editor" Height="860" Width="1480" AllowDrop="True"
        Background="{StaticResource PanelBrush}">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBrush}">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規(_N)" InputGestureText="Ctrl+N" Click="OnNew" />
                <MenuItem Header="開く(_O)…" InputGestureText="Ctrl+O" Click="OnOpen" />
                <MenuItem Header="今のファイルに追加で読み込み(_I)…" InputGestureText="Ctrl+I" Click="OnImport" />
                <MenuItem x:Name="RecentMenu" Header="最近のファイル(_R)" />
                <Separator />
                <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Click="OnSave" />
                <MenuItem Header="名前を付けて保存(_A)…" InputGestureText="Ctrl+Shift+S" Click="OnSaveAs" />
                <MenuItem Header="作業ファイルとして保存(_W)…" Click="OnSaveProject"
                          ToolTip="メッシュ・下絵・ガイド・表示や選択の状態・保存設定をそのまま .bvex に保存します（テクスチャ画像はパスだけ）" />
                <Separator />
                <MenuItem Header="書き出し(_E)（.x / .pmx）…" InputGestureText="Ctrl+E" Click="OnExport"
                          ToolTip="開いているファイルはそのままで、BVE で使う .x / .pmx を書き出します" />
                <MenuItem x:Name="ExportLastMenu" Header="前回の場所に書き出す" InputGestureText="Ctrl+Shift+E" Click="OnExportLast" />
                <MenuItem Header="テクスチャ画像の編集(_T)…" Click="OnEditTextureImage" />
                <MenuItem Header="保存設定(_P)…" Click="OnSaveOptions" />
                <MenuItem Header="読み込み時の警告を表示" Click="OnShowWarnings" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem x:Name="UndoMenu" Header="元に戻す(_U)" InputGestureText="Ctrl+Z" Click="OnUndo" />
                <MenuItem x:Name="RedoMenu" Header="やり直し(_R)" InputGestureText="Ctrl+Y" Click="OnRedo" />
                <Separator />
                <MenuItem Header="すべて選択(_A)" InputGestureText="Ctrl+A" Click="OnSelectAll" />
                <MenuItem Header="選択解除(_D)" InputGestureText="Esc" Click="OnSelectNone" />
                <MenuItem Header="削除" InputGestureText="Delete" Click="OnDelete" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem x:Name="TexturesMenu" Header="テクスチャ" IsCheckable="True" IsChecked="True" Click="OnViewOption" />
                <MenuItem x:Name="WireMenu" Header="ワイヤーフレーム" IsCheckable="True" InputGestureText="W" Click="OnViewOption" />
                <MenuItem x:Name="BackMenu" Header="裏面を赤で表示" IsCheckable="True" IsChecked="True" Click="OnViewOption" />
                <MenuItem x:Name="GridMenu" Header="グリッド (1 m)" IsCheckable="True" IsChecked="True" Click="OnViewOption" />
                <Separator />
                <MenuItem x:Name="OrthoMenu" Header="平行投影" IsCheckable="True" InputGestureText="O" Click="OnOrthoMenu" />
                <MenuItem x:Name="DimensionMenu" Header="寸法" IsCheckable="True" InputGestureText="D" Click="OnDimensionMenu" />
                <MenuItem Header="視点の操作" x:Name="NavigationMenu">
                    <MenuItem Header="標準（メタセコイア風）" Tag="Metasequoia" IsCheckable="True" Click="OnNavigationStyle"
                              ToolTip="右ドラッグ: 回転 / 中ドラッグ（Shift+右）: 移動 / Ctrl+右ドラッグ: ズーム" />
                    <MenuItem Header="Blender 風" Tag="Blender" IsCheckable="True" Click="OnNavigationStyle"
                              ToolTip="中ドラッグ: 回転 / Shift+中ドラッグ: 移動 / Ctrl+中ドラッグ: ズーム" />
                    <MenuItem Header="SketchUp 風" Tag="SketchUp" IsCheckable="True" Click="OnNavigationStyle"
                              ToolTip="中ドラッグ: 回転 / Shift+中ドラッグ: 移動" />
                    <MenuItem Header="Fusion 風" Tag="Fusion" IsCheckable="True" Click="OnNavigationStyle"
                              ToolTip="Shift+中ドラッグ: 回転 / 中ドラッグ: 移動" />
                    <Separator />
                    <MenuItem x:Name="InvertZoomMenu" Header="ホイールのズーム方向を反転" IsCheckable="True" Click="OnNavigationOption" />
                    <MenuItem x:Name="AroundMouseMenu" Header="マウスの位置を中心に回転・ズーム" IsCheckable="True" Click="OnNavigationOption"
                              ToolTip="オフにすると画面の中心を軸に回転・ズームします" />
                </MenuItem>
                <Separator />
                <MenuItem Header="全体を表示" InputGestureText="F" Click="OnFit" />
                <MenuItem Header="正面（運転台から）" InputGestureText="1" Tag="Front" Click="OnPreset" />
                <MenuItem Header="背面" InputGestureText="Ctrl+1" Tag="Back" Click="OnPreset" />
                <MenuItem Header="右側面" InputGestureText="3" Tag="Right" Click="OnPreset" />
                <MenuItem Header="左側面" InputGestureText="Ctrl+3" Tag="Left" Click="OnPreset" />
                <MenuItem Header="上面" InputGestureText="7" Tag="Top" Click="OnPreset" />
                <MenuItem Header="斜め" InputGestureText="5" Tag="Perspective" Click="OnPreset" />
                <Separator />
                <MenuItem Header="テクスチャを読み直す" Click="OnReloadTextures" />
            </MenuItem>
            <MenuItem Header="BVE(_B)">
                <MenuItem Header="線路・限界のガイド（目安）" x:Name="GuideMenu">
                    <MenuItem Header="なし" Tag="None" IsCheckable="True" IsChecked="True" Click="OnGuideGauge" />
                    <MenuItem Header="在来線 1067 mm" Tag="Narrow1067" IsCheckable="True" Click="OnGuideGauge" />
                    <MenuItem Header="在来線 1435 mm" Tag="Standard1435" IsCheckable="True" Click="OnGuideGauge" />
                    <MenuItem Header="新幹線" Tag="Shinkansen" IsCheckable="True" Click="OnGuideGauge" />
                    <Separator />
                    <MenuItem x:Name="GuidePlatformMenu" Header="ホーム端・高さ" IsCheckable="True" IsChecked="True" Click="OnGuidePlatform" />
                </MenuItem>
                <MenuItem Header="互換チェック(_C)…" Click="OnCheck" />
                <MenuItem Header="Repeater 用に分割(_R)…" Click="OnRepeater"
                          ToolTip="長いストラクチャを進行方向に切り分け、ピースごとに .x へ書き出します。曲線に並べたところも確かめられます" />
                <Separator />
                <MenuItem Header="文字から看板を作る(_S)…" Click="OnAddSign" />
                <MenuItem Header="一括変換(_B)…" Click="OnBatch" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource PanelBrush}">
            <ToolBar Background="{StaticResource PanelBrush}">
                <Button Content="開く" Click="OnOpen" />
                <Button Content="保存" Click="OnSave" />
                <Separator />
                <Button Content="↶ 元に戻す" Click="OnUndo" />
                <Button Content="↷ やり直し" Click="OnRedo" />
                <Separator />
                <TextBlock Text="選択:" VerticalAlignment="Center" Margin="4,0" />
                <RadioButton x:Name="ModeObject" Content="オブジェクト (Q)" GroupName="Mode" IsChecked="True" Checked="OnModeChecked" Margin="2,0" />
                <RadioButton x:Name="ModeFace" Content="面 (E)" GroupName="Mode" Checked="OnModeChecked" Margin="2,0" />
                <RadioButton x:Name="ModeVertex" Content="頂点 (R)" GroupName="Mode" Checked="OnModeChecked" Margin="2,0" />
                <Separator />
                <TextBlock Text="ギズモ:" VerticalAlignment="Center" Margin="4,0" />
                <RadioButton x:Name="GizmoNone" Content="なし" GroupName="Gizmo" Checked="OnGizmoChecked" Margin="2,0" />
                <RadioButton x:Name="GizmoMove" Content="移動 (G)" GroupName="Gizmo" IsChecked="True" Checked="OnGizmoChecked" Margin="2,0" />
                <RadioButton x:Name="GizmoRotate" Content="回転 (T)" GroupName="Gizmo" Checked="OnGizmoChecked" Margin="2,0" />
                <RadioButton x:Name="GizmoScale" Content="拡大 (S)" GroupName="Gizmo" Checked="OnGizmoChecked" Margin="2,0" />
                <CheckBox x:Name="MirrorCheck" Content="左右対称 (M)" Checked="OnMirrorCheck" Unchecked="OnMirrorCheck" VerticalAlignment="Center" Margin="6,0,2,0"
                          ToolTip="ON にすると、選択を移動・回転・拡大したとき、X=0 をはさんだ反対側の頂点も鏡像で動きます" />
                <Separator />
                <CheckBox x:Name="WireCheck" Content="ワイヤー" Checked="OnWireCheck" Unchecked="OnWireCheck" VerticalAlignment="Center" />
                <CheckBox x:Name="OrthoCheck" Content="平行投影 (O)" Checked="OnOrthoCheck" Unchecked="OnOrthoCheck" VerticalAlignment="Center" Margin="6,0,2,0"
                          ToolTip="遠近感なしで表示します。正面・側面・上面で寸法や位置を合わせるときに便利です" />
                <CheckBox x:Name="DimensionCheck" Content="寸法 (D)" Checked="OnDimensionCheck" Unchecked="OnDimensionCheck" VerticalAlignment="Center" Margin="2,0"
                          ToolTip="選んだ面・頂点の辺の長さを 3D ビューに表示します。オブジェクト選択や選択なしでは外形の幅・高さ・奥行を出します" />
                <Button Content="計測" Click="OnMeasure" ToolTip="3D ビューで 2 点をクリックして距離を測ります（頂点の近くでは頂点に吸着）" />
                <Button Content="全体表示" Click="OnFit" />
                <Button Content="正面" Tag="Front" Click="OnPreset" />
                <Button Content="側面" Tag="Right" Click="OnPreset" />
                <Button Content="上面" Tag="Top" Click="OnPreset" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="準備完了。.x ファイルをドラッグ＆ドロップするか「開く」から。" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatsText" Foreground="{StaticResource SubTextBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="400" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 左: メッシュ一覧 / マテリアルの表示切り替え -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="1.4*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Text="メッシュ" FontWeight="SemiBold" Margin="8,6,0,2" />
                <ListBox x:Name="MeshList" Margin="4,0" SelectionChanged="OnMeshListSelected" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Visible, Mode=OneWay}" Tag="{Binding Index}" Click="OnMeshVisibleClick" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Stats}" Foreground="#777" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}" />

            <DockPanel Grid.Row="2">
                <TextBlock x:Name="MaterialHeader" DockPanel.Dock="Top" Text="マテリアル" FontWeight="SemiBold" Margin="8,6,0,2" TextTrimming="CharacterEllipsis" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="2,2">
                    <Button Content="全部表示" Click="OnShowAllMaterials" ToolTip="このメッシュのマテリアルをすべて表示" />
                    <Button Content="これだけ表示" Click="OnSoloMaterial" ToolTip="一覧で選んでいるマテリアル以外を隠す" />
                    <Button Content="反転" Click="OnInvertMaterials" ToolTip="表示と非表示を入れ替える" />
                </WrapPanel>
                <ListBox x:Name="MaterialVisList" Margin="4,0" HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="OnMaterialDoubleClick"
                         ToolTip="チェックを外すと 3D に表示しません（隠した面は選択もされません）。ダブルクリックでそのマテリアルの面を選択">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding Tooltip}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Visible, Mode=OneWay}" Tag="{Binding Index}"
                                          Click="OnMaterialVisibleClick" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Left" Width="22" Height="22" Margin="0,1,5,1" BorderBrush="#999" BorderThickness="1" Background="{Binding Swatch}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Stats}" Foreground="#777" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Row="3">
                <TextBlock x:Name="FormatText" TextWrapping="Wrap" Margin="8,4,8,4" FontSize="11" Foreground="{StaticResource SubTextBrush}" />
            </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" />

            <!-- 中央: 3D / UV -->
            <TabControl Grid.Column="2" x:Name="CenterTabs" Margin="0" Padding="0">
                <TabItem Header="3D ビュー">
                    <v:ViewportView x:Name="Viewport" />
                </TabItem>
                <TabItem Header="UV エディタ">
                    <v:UvEditorView x:Name="UvEditor" />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" />

            <!-- 右: 編集 / テキスト -->
            <TabControl Grid.Column="4" x:Name="RightTabs" Padding="0">
                <TabItem Header="編集">
                    <v:EditPanel x:Name="Edit" />
                </TabItem>
                <TabItem Header="形を追加" x:Name="CreateTab">
                    <v:CreatePanel x:Name="Create" />
                </TabItem>
                <TabItem Header="下絵" x:Name="ReferenceTab">
                    <v:ReferencePanel x:Name="References" />
                </TabItem>
                <TabItem Header="テキスト (.x)">
                    <v:TextEditorView x:Name="TextView" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
