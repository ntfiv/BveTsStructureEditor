<Window x:Class="BveXEditor.App.Views.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一括変換" Width="620" Height="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <DockPanel Margin="16,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"
                       Text="フォルダー内の .x / .pmx をまとめて読み込み、変形やテクスチャパスの修正をしてテキスト形式の .x（または PMX）で書き出します。今開いているファイルは変わりません。" />

            <TextBlock Text="入力フォルダー" FontWeight="SemiBold" />
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="参照…" Click="OnBrowseInput" />
                <TextBox x:Name="InputDir" TextChanged="OnInputChanged" />
            </DockPanel>
            <WrapPanel Margin="0,2,0,6">
                <CheckBox x:Name="Recursive" Content="サブフォルダーも含める" IsChecked="True" Click="OnInputChanged" Margin="0,0,12,0" />
                <CheckBox x:Name="IncludeX" Content=".x" IsChecked="True" Click="OnInputChanged" Margin="0,0,12,0" />
                <CheckBox x:Name="IncludePmx" Content=".pmx" Click="OnInputChanged" />
                <TextBlock x:Name="FileCount" Foreground="{StaticResource SubTextBrush}" Margin="12,0,0,0" />
            </WrapPanel>

            <GroupBox Header="処理" Padding="6,4">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="拡大縮小" Style="{StaticResource FieldLabel}" Width="90" />
                        <TextBox x:Name="Scale" Text="1" Width="60" />
                        <TextBlock Text="倍" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="MirrorX" Content="左右反転 (X)" Margin="16,0,8,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="MirrorZ" Content="前後反転 (Z)" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="テクスチャパス" Style="{StaticResource FieldLabel}" Width="90" />
                        <TextBox x:Name="ReplaceFrom" Width="160" ToolTip="置き換える文字列（大文字小文字は区別しない）" />
                        <TextBlock Text="→" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ReplaceTo" Width="160" />
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="" Width="90" />
                        <CheckBox x:Name="MakeRelative" Content="フォルダー以下の絶対パスを相対パスに" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="RemoveUnused" Content="未使用の頂点・マテリアルを削除" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="出力" Padding="6,4" Margin="0,6,0,0">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="形式" Style="{StaticResource FieldLabel}" Width="90" />
                        <ComboBox x:Name="Format" Width="220" SelectedIndex="0">
                            <ComboBoxItem Content=".x（テキスト形式）" />
                            <ComboBoxItem Content=".pmx（形とマテリアル）" />
                        </ComboBox>
                    </WrapPanel>
                    <WrapPanel>
                        <RadioButton x:Name="OutSame" Content="元の場所に書く（上書きするものは .bak を残す）" IsChecked="True" GroupName="Out" Margin="0,4,0,2" />
                    </WrapPanel>
                    <DockPanel>
                        <RadioButton x:Name="OutFolder" Content="別のフォルダーへ（構成を保つ）" GroupName="Out" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="参照…" Click="OnBrowseOutput" />
                        <TextBox x:Name="OutputDir" Margin="8,2,2,2" GotFocus="OnOutputFocus" />
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <DockPanel Margin="0,10,0,4">
                <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="閉じる" MinWidth="80" Click="OnClose" />
                <Button DockPanel.Dock="Right" x:Name="RunButton" Content="実行" MinWidth="100" FontWeight="SemiBold" Click="OnRun" />
                <ProgressBar x:Name="Progress" Height="14" Margin="0,0,8,0" />
            </DockPanel>
            <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,4" />
        </StackPanel>
        <ListBox x:Name="Results" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" Foreground="{Binding MarkBrush}" Width="18" FontWeight="Bold" />
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  " />
                            <Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
