<UserControl x:Class="BveXEditor.App.Views.ColorPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 色見本のボタン（枠と色だけ。選ぶとその色になる） -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="#80000000" BorderThickness="1" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#E8871E" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#E8871E" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,8,0,1" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10" CornerRadius="4">
        <StackPanel Width="262">
            <!-- 鮮やかさ（横）と明るさ（縦）、色相（右の縦長） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="SvArea" Height="150" Cursor="Cross" ClipToBounds="True"
                      MouseLeftButtonDown="OnSvDown" MouseMove="OnSvMove" MouseLeftButtonUp="OnSvUp">
                    <Rectangle x:Name="HueFill" Fill="Red" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="Black" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="SvMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
                <Grid Grid.Column="2" x:Name="HueArea" Height="150" Cursor="Hand"
                      MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnHueUp">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF0000" Offset="0" />
                                <GradientStop Color="#FFFF00" Offset="0.1667" />
                                <GradientStop Color="#00FF00" Offset="0.3333" />
                                <GradientStop Color="#00FFFF" Offset="0.5" />
                                <GradientStop Color="#0000FF" Offset="0.6667" />
                                <GradientStop Color="#FF00FF" Offset="0.8333" />
                                <GradientStop Color="#FF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="HueMarker" Width="20" Height="4" Stroke="White" StrokeThickness="1.5" Fill="#40000000" />
                    </Canvas>
                </Grid>
            </Grid>

            <!-- 前の色と今の色、色コード -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#80000000" BorderThickness="1" Width="56" Height="36" CornerRadius="3" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border x:Name="NewPreview" ToolTip="選んでいる色" />
                        <Border Grid.Row="1" x:Name="OldPreview" ToolTip="元の色（クリックで戻す）" MouseLeftButtonDown="OnOldPreviewClick" Cursor="Hand" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="色コード" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="HexBox" Width="76" KeyDown="OnHexKey" LostFocus="OnHexCommitted" ToolTip="#RRGGBB を入れて Enter" />
                    </StackPanel>
                    <TextBlock x:Name="RgbText" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="2,2,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="基本の色" Style="{StaticResource Heading}" />
            <WrapPanel x:Name="BasicColors" />
            <TextBlock x:Name="MeshColorsHeading" Text="このメッシュで使っている色" Style="{StaticResource Heading}" />
            <WrapPanel x:Name="MeshColors" />
            <TextBlock x:Name="RecentHeading" Text="最近使った色" Style="{StaticResource Heading}" />
            <WrapPanel x:Name="RecentColors" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="決定" MinWidth="72" FontWeight="SemiBold" Click="OnOk" />
                <Button Content="キャンセル" MinWidth="72" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
