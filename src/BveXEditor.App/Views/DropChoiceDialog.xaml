<Window x:Class="BveXEditor.App.Views.DropChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="モデルの読み込み" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="Message" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="FileList" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,10" />

        <CheckBox x:Name="PlaceAtDrop" Content="ドロップした地点に置く（モデルの底面中心を合わせる）" Margin="0,0,0,2" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="20,0,0,12"
                   Text="外すと元の座標のまま追加します（BVE のストラクチャは原点に意味があるので、通常はこちら）。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddButton" Content="今のファイルに追加" IsDefault="True" Click="OnAdd" MinWidth="130" FontWeight="SemiBold" />
            <Button x:Name="OpenButton" Content="新しいファイルとして開く" Click="OnOpen" MinWidth="150" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
