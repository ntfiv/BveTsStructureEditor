<Window x:Class="BveXEditor.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="Value" Width="120" />
            <TextBlock x:Name="Unit" VerticalAlignment="Center" Margin="4,0" />
        </StackPanel>
        <TextBlock x:Name="Error" Foreground="#C03030" Margin="0,4,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Click="OnOk" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
