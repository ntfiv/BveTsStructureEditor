<Window x:Class="BveXEditor.App.Views.SaveOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BveXEditor.App.Views"
        Title="保存設定" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <StackPanel Margin="8,6,8,12">
        <v:SaveOptionsPanel x:Name="Panel" />
        <Button Content="閉じる" MinWidth="80" HorizontalAlignment="Right" Margin="0,4,8,0" Click="OnClose" />
    </StackPanel>
</Window>
