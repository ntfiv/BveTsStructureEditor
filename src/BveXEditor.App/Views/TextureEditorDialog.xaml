<Window x:Class="BveXEditor.App.Views.TextureEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="テクスチャの編集" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>
        <Style x:Key="Group" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="8,2,4,6" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#DDD" Geometry="M0,0 H2 V2 H0Z" />
                    <GeometryDrawing Brush="#BBB" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="編集した画像を使う" MinWidth="150" FontWeight="SemiBold" IsDefault="True" Click="OnOk" />
                <Button Content="そのまま使う" MinWidth="100" Click="OnUseOriginal" ToolTip="編集せずに元の画像を使います" />
                <Button Content="キャンセル" MinWidth="80" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="Info" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 元画像と四隅 -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="SourceTitle" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Bottom" x:Name="SourceHint" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="四隅の丸をドラッグして、使う範囲（斜めに写った壁や看板なら、その四隅）に合わせます。" />
                <Border Background="{StaticResource Checker}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                    <!-- 画像の端にある丸もつかめるよう、周りに余白を取る（Canvas は余白まで広げる） -->
                    <Grid x:Name="SourceHost" SizeChanged="OnSourceSizeChanged" Margin="14">
                        <Image x:Name="SourceImage" Stretch="Uniform" />
                        <Canvas x:Name="Handles" Background="Transparent" Margin="-14"
                                MouseLeftButtonDown="OnSourceMouseDown" MouseMove="OnSourceMouseMove" MouseLeftButtonUp="OnSourceMouseUp">
                            <Polygon x:Name="QuadShape" Stroke="#FFFFA030" StrokeThickness="2" Fill="#18FFA030" IsHitTestVisible="False" />
                        </Canvas>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- 設定 -->
            <ScrollViewer Grid.Column="1" Margin="10,0,6,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Expander Header="歪み補正・切り抜き" Style="{StaticResource Group}">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="全体に戻す" Click="OnResetCorners" />
                            </WrapPanel>
                            <WrapPanel ToolTip="補正後の縦横比。空なら四隅の辺の長さから決めます（斜めから撮った写真は縮んで見えるので、実寸がわかれば入れてください）">
                                <TextBlock Text="実寸 幅" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RealWidth" Width="50" TextChanged="OnChanged" />
                                <TextBlock Text="× 高さ" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RealHeight" Width="50" TextChanged="OnChanged" />
                                <TextBlock Text="m（空なら自動）" Style="{StaticResource FieldLabel}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="回転・反転" Style="{StaticResource Group}">
                        <WrapPanel>
                            <Button Content="↺ 90°" Click="OnRotateLeft" />
                            <Button Content="↻ 90°" Click="OnRotateRight" />
                            <CheckBox x:Name="FlipH" Content="左右反転" Checked="OnChanged" Unchecked="OnChanged" VerticalAlignment="Center" Margin="6,0" />
                            <CheckBox x:Name="FlipV" Content="上下反転" Checked="OnChanged" Unchecked="OnChanged" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Expander>

                    <Expander Header="シームレス化（並べても継ぎ目が出ない）" Style="{StaticResource Group}">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="SeamH" Content="横につなぐ" Checked="OnChanged" Unchecked="OnChanged" Margin="0,0,10,0" />
                                <CheckBox x:Name="SeamV" Content="縦につなぐ" Checked="OnChanged" Unchecked="OnChanged" />
                            </WrapPanel>
                            <WrapPanel ToolTip="反対側の端と重ねてなじませる幅。広いほど継ぎ目はなめらかですが、画像の端が少し削れます">
                                <TextBlock Text="重ね幅" Style="{StaticResource FieldLabel}" Width="56" />
                                <Slider x:Name="Overlap" Minimum="5" Maximum="40" Value="15" ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="OverlapText" Style="{StaticResource FieldLabel}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="色調整" Style="{StaticResource Group}">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="明るさ" Style="{StaticResource FieldLabel}" Width="56" />
                                <Slider x:Name="Brightness" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="BrightnessText" Style="{StaticResource FieldLabel}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="コントラスト" Style="{StaticResource FieldLabel}" Width="56" />
                                <Slider x:Name="Contrast" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="ContrastText" Style="{StaticResource FieldLabel}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="彩度" Style="{StaticResource FieldLabel}" Width="56" />
                                <Slider x:Name="Saturation" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="SaturationText" Style="{StaticResource FieldLabel}" />
                            </WrapPanel>
                            <Button Content="色を戻す" HorizontalAlignment="Left" Click="OnResetColor" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="透過色" Style="{StaticResource Group}">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="KeyCheck" Content="この色に近い部分を透明にする" Checked="OnChanged" Unchecked="OnChanged" VerticalAlignment="Center" />
                            </WrapPanel>
                            <WrapPanel>
                                <Border x:Name="KeySwatch" Width="36" Height="20" BorderBrush="#888" BorderThickness="1" Background="#0000FF" Margin="0,2,6,2" />
                                <ToggleButton x:Name="PickButton" Content="スポイト" Padding="8,2"
                                              ToolTip="押してから左の画像をクリックすると、その色を透過色にします" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="許容差" Style="{StaticResource FieldLabel}" Width="56" />
                                <Slider x:Name="KeyTolerance" Minimum="0" Maximum="60" Value="15" ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="KeyToleranceText" Style="{StaticResource FieldLabel}" />
                            </WrapPanel>
                            <WrapPanel ToolTip="許容差の外側で、少しずつ不透明に戻す幅。境目のギザギザを和らげます">
                                <TextBlock Text="ぼかし" Style="{StaticResource FieldLabel}" Width="56" />
                                <Slider x:Name="KeySoftness" Minimum="0" Maximum="30" Value="5" ValueChanged="OnSliderChanged" />
                                <TextBlock x:Name="KeySoftnessText" Style="{StaticResource FieldLabel}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="出力の大きさ" Style="{StaticResource Group}">
                        <StackPanel>
                            <WrapPanel ToolTip="自動: 見た目の縦横比に近い 2 の累乗の組み合わせ（長辺は上限まで）">
                                <TextBlock Text="幅" Style="{StaticResource FieldLabel}" Width="56" />
                                <ComboBox x:Name="OutW" Width="72" SelectedIndex="0" SelectionChanged="OnChanged">
                                    <ComboBoxItem Content="自動" /><ComboBoxItem Content="256" /><ComboBoxItem Content="512" /><ComboBoxItem Content="1024" /><ComboBoxItem Content="2048" />
                                </ComboBox>
                                <TextBlock Text="高さ" Style="{StaticResource FieldLabel}" Margin="8,0,4,0" />
                                <ComboBox x:Name="OutH" Width="72" SelectedIndex="0" SelectionChanged="OnChanged">
                                    <ComboBoxItem Content="自動" /><ComboBoxItem Content="256" /><ComboBoxItem Content="512" /><ComboBoxItem Content="1024" /><ComboBoxItem Content="2048" />
                                </ComboBox>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="自動の上限" Style="{StaticResource FieldLabel}" Width="56" />
                                <ComboBox x:Name="AutoMax" Width="72" SelectedIndex="1" SelectionChanged="OnChanged">
                                    <ComboBoxItem Content="512" /><ComboBoxItem Content="1024" /><ComboBoxItem Content="2048" />
                                </ComboBox>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- 結果 -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <CheckBox DockPanel.Dock="Right" x:Name="TilePreview" Content="2×2 に並べて表示" Checked="OnTileChanged" Unchecked="OnTileChanged"
                              ToolTip="シームレス化の確認用。並べたときの継ぎ目を見ます" />
                    <TextBlock Text="結果" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="ResultInfo" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                <Border Background="{StaticResource Checker}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Viewbox Stretch="Uniform" Margin="6">
                        <Rectangle x:Name="ResultRect" Width="200" Height="200" />
                    </Viewbox>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
